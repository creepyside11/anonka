# Required: Telegram bot token from @BotFather
BOT_TOKEN=123456789:replace_me

# Required for GitHub OAuth
GITHUB_CLIENT_ID=replace_me
GITHUB_CLIENT_SECRET=replace_me

# REQUIRED in production. Generate once and keep the same value across restarts.
# Example generator: python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=replace_with_a_long_random_secret

# Primary public URL used for the GitHub OAuth redirect URI.
# With the current code OAuth will always return to this domain.
BASE_URL=https://emeraldhost.beer

# Optional Emerald statistics integration.
# Both values must be set for statistics to be enabled.
EMERALD_STATS_URL=https://replace-me.example/api/stats
EMERALD_STATS_KEY=replace_me

# Web server (PORT is often injected automatically by hosting platforms)
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# SQLite / GitHub sync storage
DB_PATH=bot.db
DASHBOARD_DB=dashboard.db
GITHUB_SYNC_ROOT=projects
